# Production template only. Copy values into Render's environment settings.
# Never commit real secrets.

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

COOKIE_SECURE=true
# vercel.app -> onrender.com is cross-site; use SameSite=None with Secure.
COOKIE_SAMESITE=none
CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app

QDRANT_URL=https://YOUR-QDRANT-CLUSTER
QDRANT_API_KEY=
QDRANT_COLLECTION=securerag

EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=

# Render Free disk is ephemeral. Keep local until persistent storage (R2) is
# explicitly approved; do not create an R2 bucket just for this deployment.
STORAGE_PROVIDER=local
STORAGE_DIR=data/uploads
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=your-private-bucket
# STORAGE_ENDPOINT_URL=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=10485760

LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30

RERANKER_PROVIDER=heuristic
RERANKER_MODEL=
RERANKER_TOP_K=5
RERANKER_MAX_CANDIDATES=40

RETRIEVAL_MODE=hybrid

RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
