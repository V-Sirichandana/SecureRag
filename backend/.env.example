# --- Database / cache -------------------------------------------------
DATABASE_URL=postgresql+asyncpg://securerag:securerag@localhost:5432/securerag
REDIS_URL=redis://localhost:6379/0

# --- Authentication ----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development (an ephemeral secret is generated at startup).
# REQUIRED (non-empty) when APP_ENV=production.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Never use * for authenticated APIs. APP_ENV=production rejects wildcard
# origins and DEBUG=true at startup.
CORS_ORIGINS=http://localhost:3000

# --- RAG providers (modular) --------------------------------------------
# Qdrant URL. Local dev: start with `docker compose up -d qdrant` (repo root),
# or set `:memory:` for an ephemeral embedded instance (tests/dev only).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Single vector collection shared by all tenants; tenant_id is always enforced
# as a server-side filter, collection naming alone is never trusted.
QDRANT_COLLECTION=securerag

# Embeddings: `hashing` (deterministic, no downloads; default) or `fastembed`
# (local semantic model; optional: pip install -r requirements-fastembed.txt).
EMBEDDING_PROVIDER=hashing
# FastEmbed model. When EMBEDDING_PROVIDER=fastembed and this is empty, the
# supported default BAAI/bge-small-en-v1.5 is used. EMBEDDING_DIM must equal
# the model's actual metadata dimension or provider construction fails with
# 501 — there is no silent fallback to hashing.
# Recommended FastEmbed models (dimension / download / license):
#   BAAI/bge-small-en-v1.5                 384   ~67 MB   MIT
#   BAAI/bge-base-en-v1.5                  768   ~210 MB  MIT
#   BAAI/bge-large-en-v1.5                 1024  ~1.2 GB  MIT
#   sentence-transformers/all-MiniLM-L6-v2 384   ~90 MB   Apache-2.0
#   intfloat/multilingual-e5-large         1024  ~2.24 GB MIT
#   jinaai/jina-embeddings-v3              1024  ~2.29 GB CC-BY-NC-4.0 (non-commercial)
# BAAI/bge-m3 is NOT in FastEmbed's dense text model registry (0.8.x).
EMBEDDING_MODEL=
EMBEDDING_DIM=384
# Optional FastEmbed weight cache. Empty uses FastEmbed's own default cache.
# Models download on the first embedding call, never at application startup.
EMBEDDING_CACHE_DIR=

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Ingestion
# Where uploaded files are persisted (never committed to git).
STORAGE_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760

# --- Document storage ---------------------------------------------------
# `local` (default) keeps the existing filesystem layout. `s3` enables an
# optional S3-compatible backend; install requirements-s3.txt first.
# Object keys are server-generated (<tenant_id>/<document_id>.<ext>) and the
# bucket must remain private. Credentials are never returned by the API.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
# Custom S3-compatible endpoint (for example MinIO); leave empty for AWS.
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
# Leave both empty to use the SDK credential chain (IAM role, profile, etc.).
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Reranker: `heuristic` (default) is the offline lexical provider — no model,
# no network, no API key. `fastembed` selects a local neural cross-encoder and
# requires the optional FastEmbed dependency (pip install 'fastembed>=0.4.2').
# The model is downloaded/loaded lazily on the first query, never at startup.
# Supported FastEmbed rerankers: Xenova/ms-marco-MiniLM-L-6-v2 (default,
# ~80 MB), Xenova/ms-marco-MiniLM-L-12-v2 (~120 MB), BAAI/bge-reranker-base
# (~1.04 GB), jinaai/jina-reranker-v1-tiny-en (~130 MB),
# jinaai/jina-reranker-v1-turbo-en (~150 MB),
# jinaai/jina-reranker-v2-base-multilingual (~1.11 GB, CC-BY-NC-4.0).
# RERANKER_MODEL is unused by the heuristic provider.
RERANKER_PROVIDER=heuristic
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Final result count, and the candidate pool the reranker may score.
# RERANKER_TOP_K must not exceed RERANKER_MAX_CANDIDATES.
RERANKER_TOP_K=5
RERANKER_MAX_CANDIDATES=40

# Retrieval mode (server-side only; never part of the client request).
# `vector` is the current/default vector-only retrieval pipeline.
# `hybrid` is reserved for the upcoming lexical (BM25) implementation:
# there is NO lexical backend in this release, so `hybrid` does not
# enable BM25 — it behaves exactly like `vector` until M2+ land.
RETRIEVAL_MODE=vector

# Answer generation (production LLM provider).
# LLM_PROVIDER selects the registered provider implementation; `openai` speaks
# the OpenAI-compatible chat-completions API and also serves any
# OpenAI-compatible server via LLM_BASE_URL (e.g. local Ollama).
# Real generation requests fail with 501 (SERVICE_NOT_CONFIGURED) until
# LLM_PROVIDER, LLM_MODEL and LLM_API_KEY are set. Never commit real keys.
LLM_PROVIDER=openai
LLM_API_KEY=
# Model name to request, e.g. gpt-4o-mini or llama3.2 (local Ollama).
LLM_MODEL=
# OpenAI-compatible endpoint. Hosted default: https://api.openai.com/v1.
# Local Ollama example: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
# Upstream request timeout in seconds; timeouts surface as 503.
LLM_TIMEOUT_SECONDS=30

# --- Runtime ------------------------------------------------------------
APP_ENV=development
# Production (APP_ENV=production) requires JWT_SECRET_KEY and rejects DEBUG=true.
DEBUG=false
LOG_LEVEL=INFO
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
